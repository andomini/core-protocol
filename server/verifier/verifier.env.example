# Copy to verifier.env (git-ignored; install.sh does it) and fill in.
# The deployed Worker, no trailing slash:
LB_URL=https://core-protocol-lb.<your-subdomain>.workers.dev
# Same value as `npx wrangler secret put ADMIN_TOKEN`:
ADMIN_TOKEN=
# Optional (defaults shown):
# REPO=<this checkout>
# CACHE=<REPO>/.verifier-cache
# BATCH=20
# MAX_RUNS=200
# TIMEOUT_MS=300000
# STALE_HOURS=48
# KEEP_WORKTREES=6
